{
  "name": "callboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production planning workspace for small film, event and photo-shoot crews.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && eslint . --max-warnings 0",
    "lint:logical": "tsx scripts/check-logical-properties.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "tsx scripts/check-locales.ts",
    "verify": "pnpm lint && pnpm lint:logical && pnpm format:check && pnpm typecheck && pnpm i18n:check && pnpm test && pnpm build",
    "typegen": "next typegen",
    "docs:rbac": "tsx scripts/generate-rbac-matrix.ts",
    "seed:demo": "tsx --env-file=.env.local scripts/seed-demo.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^10.0.1",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.1.0"
  }
}
