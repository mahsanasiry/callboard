# Public origin of the deployed site. Used for canonical URLs and hreflang tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings (Project Settings > API). Both values are safe to
# expose to the browser; access is enforced by row level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
