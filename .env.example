# Public origin of the deployed site. Used for canonical URLs, hreflang tags and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Supabase project settings (Project Settings > API). Both values are safe to
# expose to the browser; access is enforced by row level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Demo accounts. The sign-in buttons on the login page appear only when both
# values are set. {role} is replaced by owner, producer, department-lead, crew
# or viewer. Use an address you control, for example name+callboard-{role}@gmail.com.
DEMO_EMAIL_TEMPLATE=you+callboard-{role}@example.com
DEMO_ACCOUNT_PASSWORD=choose-a-long-password

# Only for `pnpm seed:demo` on your own machine. Never commit it and never set it
# on the deployed site. Project Settings > API > secret key.
SUPABASE_SECRET_KEY=
